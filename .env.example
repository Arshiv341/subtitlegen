# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string, or leave empty to use built-in local JSON store)
MONGODB_URI=mongodb://localhost:27017/videotext

# Speech-to-Text Provider (Managed by application owner on backend)
TRANSCRIPTION_PROVIDER=gemini

# Server-side secret. Never expose this to the React frontend.
GEMINI_API_KEY=

# File Storage & Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
